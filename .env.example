# =====================================================
# 🏠 BRIGHT & SHINE OPERATING SYSTEM (BSOS) - Production Environment
# =====================================================
# Copy this file to .env.local and fill in your actual values
# For production deployment on Vercel, set these in Vercel Dashboard

# ============================================================================
# 🚀 VERCEL DEPLOYMENT QUICK START (REQUIRED FOR PRODUCTION)
# ============================================================================
#
# Step 1: Create Neon PostgreSQL Database
# ----------------------------------------
# 1. Go to https://neon.tech/ and create a new database
# 2. Copy the connection string (format below)
# 3. Make sure it includes ?sslmode=require for production
#
DATABASE_URL="postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require"
#
# Step 2: Generate JWT Secret
# ----------------------------
# Run this command in your terminal:
#   openssl rand -base64 32
#
# Then paste the output below:
JWT_SECRET="your_generated_jwt_secret_minimum_32_characters"
#
# Step 3: Set Application URL
# ---------------------------
# Development:
NEXT_PUBLIC_APP_URL="http://localhost:3020"
#
# Production (after first deploy, update with your Vercel domain):
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
#
# ============================================================================
# 📋 VERCEL DEPLOYMENT CHECKLIST
# ============================================================================
#
# ✅ 1. Push code to GitHub
# ✅ 2. Import repository in Vercel Dashboard
# ✅ 3. Add Environment Variables in Vercel → Settings → Environment Variables:
#        - DATABASE_URL (Production + Preview)
#        - JWT_SECRET (Production + Preview)
#        - NEXT_PUBLIC_APP_URL (Production + Preview)
#
# ✅ 4. Configure Build Settings (auto-detected from next.config.js):
#        - Build Command: npm run vercel-build
#        - Output Directory: .next
#        - Install Command: npm install
#
# ✅ 5. Deploy! (first deploy will auto-run "npm run postinstall")
#
# ✅ 6. After first deploy, run migrations:
#        DATABASE_URL="your-neon-url" npx prisma migrate deploy
#
# ✅ 7. Seed demo data (optional):
#        DATABASE_URL="your-neon-url" npm run prisma:seed
#
# ============================================================================

# ================================
# 🌐 APPLICATION SETTINGS
# ================================
NEXT_PUBLIC_APP_NAME=Bright & Shine OS
NEXT_PUBLIC_SHOW_DEMO=true
NEXT_PUBLIC_DEMO_PWD=demo123
NODE_ENV=production

# ================================
# 🔐 SECURITY & AUTHENTICATION
# ================================
# NextAuth.js Configuration (if you add NextAuth.js in the future)
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_required

# Google OAuth (placeholder for future use)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Additional Security Keys (optional)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=your_webhook_secret_for_verification_purposes
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data_protection

# ================================
# 🗄️ DATABASE CONFIGURATION
# ================================
# Alternative unpooled connection (for migrations, optional)
DATABASE_URL_UNPOOLED=postgresql://username:password@ep-xxx.region.aws.neon.tech/database_name

# Optional: Enable HTTP mode (if using Neon serverless driver)
NEON_HTTP=false

# ================================
# 🎭 DEMO USER CONFIGURATION
# ================================
# Demo user credentials for testing (used by seed script)
NEXT_PUBLIC_DEMO_PWD=demo123
NEXT_PUBLIC_DEMO_EMAIL_ADMIN=admin@demo.local
NEXT_PUBLIC_DEMO_EMAIL_MANAGER=manager@demo.local
NEXT_PUBLIC_DEMO_EMAIL_SUPERVISOR=supervisor@demo.local
NEXT_PUBLIC_DEMO_EMAIL_CLEANER=cleaner@demo.local
NEXT_PUBLIC_DEMO_EMAIL_CLIENT=client@demo.local

# ================================
# 💳 STRIPE PAYMENT PROCESSING
# ================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_stripe_dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here

# For testing (use test keys)
# STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
# STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# ================================
# � AIRBNB INTEGRATION
# ================================
# Get these from Airbnb Partner Portal
AIRBNB_CLIENT_ID=your_airbnb_client_id
AIRBNB_CLIENT_SECRET=your_airbnb_client_secret
AIRBNB_REDIRECT_URI=https://your-domain.vercel.app/api/integrations/airbnb/callback

# ================================
# 📱 WHATSAPP BUSINESS API
# ================================
# Get these from Meta Business Platform
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verification_token

# ================================
# 📧 EMAIL SERVICE (SendGrid)
# ================================
# Get API key from https://sendgrid.com/
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@your-domain.com
SENDGRID_FROM_NAME=Bright & Shine

# ================================
# 📊 ANALYTICS & MONITORING
# ================================
# Vercel Analytics (automatically enabled in production)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ================================
# 🔍 ERROR TRACKING (Sentry)
# ================================
# Get DSN from https://sentry.io/
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ORG=your_sentry_organization
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ================================
# ⚙️ PERFORMANCE & RATE LIMITING
# ================================
# Enable rate limiting in production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Redis for rate limiting (optional, uses memory store if not provided)
REDIS_URL=redis://username:password@host:port

# ================================
# 🔧 DEVELOPMENT & DEBUG SETTINGS
# ================================
# Disable debug mode in production
DEBUG=false

# ================================
# 🌍 INTERNATIONALIZATION
# ================================
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_SUPPORTED_LOCALES=pt-BR,en-US,es-ES

# ================================
# 📱 PWA SETTINGS
# ================================
NEXT_PUBLIC_PWA_ENABLED=true

# ================================
# 🔒 CORS SETTINGS
# ================================
ALLOWED_ORIGINS=https://your-domain.vercel.app,https://your-custom-domain.com

# ================================
# 📦 STORAGE (Optional - for file uploads)
# ================================
# Vercel Blob Storage (for avatar uploads)
# Get these from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Or Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ================================
# 🔔 PUSH NOTIFICATIONS (Optional)
# ================================
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@your-domain.com

# ================================
# 🎯 FEATURE FLAGS
# ================================
FEATURE_FINANCE_MODULE=true
FEATURE_ANALYTICS=true
FEATURE_INTEGRATIONS=true
FEATURE_MOBILE_APP=true
FEATURE_OFFLINE_MODE=true

# ================================
# 📈 THIRD-PARTY INTEGRATIONS
# ================================
# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# Discord notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook

# ================================
# 🛡️ SECURITY HEADERS
# ================================
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true

# ================================
# 📊 LOGGING
# ================================
LOG_LEVEL=info
LOG_FORMAT=json

# ================================
# 🔄 BACKUP & SYNC
# ================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
# Obtidas em: https://dashboard.hostaway.com/api-keys
HOSTAWAY_API_KEY=your_hostaway_api_key_here
HOSTAWAY_API_SECRET=your_hostaway_api_secret_here
HOSTAWAY_BASE_URL=https://api.hostaway.com/v1

# ================================
# 🌐 BOOKING.COM
# ================================
# Obtidas em: https://developers.booking.com/
BOOKING_CLIENT_ID=your_booking_client_id_here
BOOKING_CLIENT_SECRET=your_booking_client_secret_here

# ================================
# 🏖️ VRBO/EXPEDIA
# ================================
# Obtidas em: https://developers.expediagroup.com/
VRBO_API_KEY=your_vrbo_api_key_here
VRBO_SECRET=your_vrbo_secret_here

# ================================
# 📱 WHATSAPP BUSINESS API
# ================================
# Obtidas em: https://developers.facebook.com/apps/
WHATSAPP_API_TOKEN=your_whatsapp_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here

# ================================
# 📧 SENDGRID EMAIL
# ================================
# Obtida em: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@brightshine.com
SENDGRID_FROM_NAME=Bright & Shine

# ================================
# 📱 TWILIO SMS
# ================================
# Obtidas em: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+5521999999999

# ================================
# 🗄️ BANCO DE DADOS
# ================================
# Para desenvolvimento (opcional - usa banco simulado)
# DATABASE_URL=postgresql://username:password@localhost:5432/brightshine_dev

# Para produção (PostgreSQL)
# DATABASE_URL=postgresql://username:password@host:5432/brightshine_prod

# Para produção (MongoDB)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/brightshine

# ================================
# 🔐 SEGURANÇA
# ================================
# Secret para validar webhooks
WEBHOOK_SECRET=your_webhook_validation_secret_here

# Chave de criptografia para dados sensíveis
ENCRYPTION_KEY=your_32_character_encryption_key_here

# ================================
# 📊 MONITORAMENTO
# ================================
# Sentry para tracking de erros (opcional)
# SENTRY_DSN=https://your-sentry-dsn-here

# Google Analytics (opcional)
# NEXT_PUBLIC_GA_TRACKING_ID=GA-XXXXXXXXX

# ================================
# 🔧 FERRAMENTAS ADICIONAIS
# ================================
# Taskbird para gestão de tarefas
# TASKBIRD_API_KEY=your_taskbird_api_key_here

# Turno para gestão de funcionários
# TURNO_API_KEY=your_turno_api_key_here

# ================================
# 💾 STORAGE (OPCIONAL)
# ================================
# AWS S3 para upload de arquivos
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=brightshine-uploads

# ================================
# 🎯 CONFIGURAÇÕES DE PRODUÇÃO
# ================================
# Apenas para ambiente de produção
# VERCEL_URL=https://brightshine.vercel.app
# RAILWAY_STATIC_URL=https://brightshine.railway.app

# Rate limiting (requests por minuto)
RATE_LIMIT_RPM=100

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ================================
# 📋 INSTRUÇÕES DE SETUP
# ================================
#
# 1. AIRBNB:
#    - Acesse: https://www.airbnb.com/partner
#    - Registre sua aplicação
#    - Configure redirect URI: http://localhost:3000/api/integrations/airbnb/callback
#
# 2. WHATSAPP:
#    - Acesse: https://developers.facebook.com/
#    - Crie uma app > WhatsApp > Business
#    - Configure webhook URL: http://localhost:3000/api/webhooks/whatsapp
#
# 3. SENDGRID:
#    - Acesse: https://sendgrid.com/
#    - API Keys > Create API Key > Full Access
#    - Configure domínio e DNS se necessário
#
# 4. TWILIO:
#    - Acesse: https://console.twilio.com/
#    - Compre um número de telefone
#    - Configure webhook: http://localhost:3000/api/webhooks/twilio
#
# 5. HOSTAWAY:
#    - Acesse: https://dashboard.hostaway.com/
#    - Integrações > API Keys > Gerar nova chave
#
# ================================
# 🚨 IMPORTANTE - SEGURANÇA
# ================================
#
# ❌ NUNCA commite este arquivo com credenciais reais
# ✅ Use .env.local para desenvolvimento
# ✅ Use variáveis de ambiente no deploy (Vercel, Railway, etc.)
# ✅ Rotacione chaves regularmente
# ✅ Use diferentes credenciais para dev/staging/prod
#
# ================================