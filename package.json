{
  "name": "bright-shine-operating-system",
  "version": "2.0.0",
  "description": "BSOS - Where Cleaning Meets Intelligence. Sistema Operacional Inteligente para Gestão de Limpeza",
  "private": true,
  "prisma": {
    "seed": "node ./prisma/seed.js"
  },
  "scripts": {
    "predev": "node scripts/kill-port.mjs",
    "dev": "node scripts/dev-with-fallback.mjs",
    "who-owns-port": "node scripts/who-owns-port.mjs",
    "prestart": "sh -c 'rm -rf .next || true'",
    "start": "next start -p ${PORT:-3020}",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "setup-production": "node scripts/setup-production.js",
    "db:migrate": "node scripts/migrate.js",
    "db:schema": "psql $DATABASE_URL -f scripts/database-schema.sql",
    "deploy:vercel": "vercel --prod",
    "deploy:production": "node scripts/deploy-production.js",
    "test": "echo \"No tests specified\" && exit 0",
    "test:api": "node scripts/test-api-routes.js",
    "predeployment:test": "npm run type-check && npm run test:api",
    "repair": "node scripts/repair.mjs",
    "repair:build": "node scripts/repair.mjs && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@prisma/client": "^5.20.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^10.21.0",
    "@stripe/stripe-js": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "@vercel/analytics": "^1.5.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.23.24",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "next": "15.5.4",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.0.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.2.1",
    "stripe": "^19.1.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.4.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "detect-port": "^1.6.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.4",
    "prisma": "^5.20.0",
    "puppeteer": "^24.25.0",
    "typescript": "^5"
  }
}
