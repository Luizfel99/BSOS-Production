{
  "name": "bright-shine-operating-system",
  "version": "2.0.0",
  "description": "BSOS - Where Cleaning Meets Intelligence. Sistema Operacional Inteligente para Gestão de Limpeza",
  "private": true,
  "prisma": {
    "seed": "node --import=dotenv/config ./prisma/seed.mjs"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "port:kill": "node -e \"const {execSync}=require('node:child_process');try{execSync('lsof -ti:3020 | xargs -r kill -9',{stdio:'ignore'})}catch{}\"",
    "clean": "rm -rf .next .turbo || true",
    "predev": "bash scripts/kill-ports.sh",
    "dev": "node scripts/dev-with-fallback.mjs",
    "dev:turbo": "node --max-old-space-size=4096 scripts/dev-with-fallback.mjs --turbo",
    "restart": "npm run port:kill && npm run clean && npm run dev",
    "who-owns-port": "node scripts/who-owns-port.mjs",
    "prestart": "sh -c 'rm -rf .next || true'",
    "start": "next start -p ${PORT:-3020}",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "prisma:gen": "prisma generate",
    "prisma:seed": "node prisma/seed.mjs",
    "seed:full": "FULL_SEED=1 node prisma/seed.mjs",
    "ci": "npm run prisma:gen && npm run type-check && npm run build && npm run test:run",
    "setup-production": "node scripts/setup-production.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:deploy": "cross-env DATABASE_URL=$DATABASE_URL prisma migrate deploy",
    "db:seed:prod": "cross-env DATABASE_URL=$DATABASE_URL tsx prisma/seed.ts",
    "db:schema": "psql $DATABASE_URL -f scripts/database-schema.sql",
    "db:seed": "npx prisma db seed",
    "deploy:vercel": "vercel --prod",
    "deploy:production": "node scripts/deploy-production.js",
    "deploy:neon": "node scripts/deploy-neon.mjs",
    "postdeploy:seed": "node scripts/postdeploy-seed.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:api": "node scripts/test-api-routes.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright install --with-deps && playwright test",
    "clean:demo": "node scripts/remove-demo-banners.mjs",
    "test:e2e:nobanner": "playwright test tests/e2e/00-no-banner-login.spec.ts",
    "predeployment:test": "npm run type-check && npm run test:api",
    "repair": "node scripts/repair.mjs",
    "repair:build": "node scripts/repair.mjs && npm run build",
    "codemod:wire-buttons": "node scripts/codemods/wire-buttons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@prisma/client": "^5.20.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^10.21.0",
    "@stripe/stripe-js": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.0.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.23.24",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "next": "15.5.4",
    "next-intl": "^4.5.3",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.0.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.4.1",
    "stripe": "^19.1.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.4.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/generator": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@neondatabase/serverless": "^0.10.4",
    "@playwright/test": "^1.56.1",
    "@prisma/adapter-neon": "^5.22.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^4.0.10",
    "cross-env": "^7.0.3",
    "detect-port": "^1.6.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.4",
    "glob": "^12.0.0",
    "prisma": "^5.20.0",
    "puppeteer": "^24.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.10"
  }
}
